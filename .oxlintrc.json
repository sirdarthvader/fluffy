{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "coverage/**",
    "packages/create-fluffy-app/src/template/**"
  ],
  "env": {
    "browser": true,
    "node": true
  },
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "rules": {
    "unicorn/no-empty-file": "off"
  }
}
