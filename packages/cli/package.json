{
  "name": "@fluffy-ts/cli",
  "version": "0.0.2",
  "type": "module",
  "description": "Command-line interface for developing fluffy-ts applications.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/sirdarthvader/fluffy",
    "directory": "packages/cli"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fluffy": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --sourcemap",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@fluffy-ts/core": "workspace:*",
    "@clack/prompts": "^0.10.0"
  }
}
