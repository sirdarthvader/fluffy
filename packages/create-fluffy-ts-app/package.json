{
  "name": "@fluffy-ts/create-app",
  "version": "0.0.2",
  "type": "module",
  "description": "Project scaffolder for new fluffy-ts applications.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/sirdarthvader/fluffy",
    "directory": "packages/create-fluffy-ts-app"
  },
  "files": [
    "dist",
    "src/template"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "create-fluffy-ts-app": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --minify",
    "dev": "tsup src/index.ts --format esm --watch --sourcemap --dts",
    "start": "node dist/index.js ",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "figlet": "^1.8.0",
    "fs-extra": "^11.3.0",
    "gradient-string": "^3.0.0",
    "handlebars": "^4.7.8",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^22.13.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
